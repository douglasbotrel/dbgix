# Banco de dados
# Desenvolvimento local — SQLite (simples, sem instalação):
# DATABASE_URL="file:./dev.db"
# Produção — PostgreSQL (Neon, Railway, Supabase, etc.):
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# JWT Secret — OBRIGATÓRIO. Gere com:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA use o valor padrão em produção.
JWT_SECRET="GERE-UMA-STRING-ALEATORIA-FORTE-COM-64-CHARS-HEX"
JWT_EXPIRES_IN="7d"

# Next.js
NEXTAUTH_URL="https://seu-sistema.vercel.app"
NEXTAUTH_SECRET="GERE-OUTRO-SECRET-AQUI"

# Upload de arquivos
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760

# App
APP_NAME="Ecdise"
APP_URL="https://seu-sistema.vercel.app"
