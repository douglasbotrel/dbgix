// dbgix - Schema do Banco de Dados
// Versão reduzida do Ecdise: Dashboard, Tarefas da Semana, Operacional, BI/Relatórios, Cadastro Base

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIOS E PERMISSÕES
// Role: ADMIN | GESTOR_GERAL | GESTOR_ADMINISTRATIVO | GESTOR_OPERACIONAL | GESTOR_CAMPO | SUPERVISOR | ANALISTA | ANALISTA_RAPIDO | TECNICO_CAMPO
// Departamento: GESTAO_GERAL | OPERACIONAL_AMBIENTAL | OPERACIONAL_REGULARIZACAO | BI
// ============================================================

model Usuario {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  senha         String
  cargo         String?
  telefone      String?
  avatar        String?
  role          String   @default("ANALISTA")
  departamento  String   @default("OPERACIONAL_AMBIENTAL")
  modulosAcesso String?  // JSON: ["dashboard","operacional",...]
  ativo         Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  projetosResponsavel    Projeto[]   @relation("ProjetoResponsavel")
  projetosSupervisor     Projeto[]   @relation("ProjetoSupervisor")
  projetosAnalistaRapido Projeto[]   @relation("ProjetoAnalistaRapido")
  tarefasResponsavel     Tarefa[]    @relation("TarefaResponsavel")
  documentosUpload       Documento[]
  notificacoes           Notificacao[]
  logs                   Log[]
  comentarios            Comentario[]
  tarefasSemana          TarefaSemana[]

  @@map("usuarios")
}

// ============================================================
// PROJETOS
// Ponto de entrada único: um Projeto nasce direto em etapaPipeline=OPERACIONAL
// (criado pela tela Operacional). Não existe mais esteira comercial/contrato/financeiro,
// nem cadastro de cliente/imóvel/tipo de serviço — só o essencial: nome, responsável,
// prazo, tarefas e observações.
// statusOperacional: NAO_INICIADO | EM_ANDAMENTO | EM_CAMPO | AGUARDANDO_INFO | EM_REVISAO | CONCLUIDO | CANCELADO
// etapaPipeline: OPERACIONAL | EM_EXECUCAO | CONCLUIDO | CANCELADO
// ============================================================

model Projeto {
  id                   String   @id @default(cuid())
  codigo               String   @unique @default(cuid())
  nome                 String
  statusOperacional    String   @default("NAO_INICIADO")
  descricao            String?
  observacoes          String?
  dataEntrada          DateTime @default(now())
  dataInicio           DateTime?
  dataPrazo            DateTime?
  dataConclusao        DateTime?
  responsavelId        String?
  supervisorId         String?
  analistaRapidoId     String?
  gestorResponsavelId  String?
  etapaPipeline        String   @default("OPERACIONAL")
  // Protocolo e credenciais do sistema regulatório (preenchidos ao final da execução em Operacional)
  credenciais          String?  // JSON: {"SIGLA":{"login":"...","senha":"..."},"CTF":{...}}
  protocoloData        DateTime?
  protocoloCodigoOrgao String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  responsavel    Usuario?  @relation("ProjetoResponsavel",    fields: [responsavelId],    references: [id])
  supervisor     Usuario?  @relation("ProjetoSupervisor",     fields: [supervisorId],     references: [id])
  analistaRapido Usuario?  @relation("ProjetoAnalistaRapido", fields: [analistaRapidoId], references: [id])
  tarefas        Tarefa[]
  documentos     Documento[]
  comentarios    Comentario[]
  historico      HistoricoStatus[]

  @@map("projetos")
}

// ============================================================
// TAREFAS
// tipo: ETAPA | TAREFA | MARCO | ENTREGA
// status: PENDENTE | EM_ANDAMENTO | CONCLUIDA | ATRASADA | CANCELADA | AGUARDANDO
// ============================================================

model Tarefa {
  id            String   @id @default(cuid())
  projetoId     String
  titulo        String
  descricao     String?
  observacao    String?  // Nota de tentativa: motivo pelo qual a tarefa não pôde ser concluída
  tipo          String   @default("TAREFA")
  status        String   @default("PENDENTE")
  responsavelId String?
  prazo         DateTime?
  dataConclusao DateTime?
  ordem         Int      @default(0)
  etapa         String?
  obrigatorio   Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // ── Recorrência ──────────────────────────────────────────────────
  // Uma tarefa "mestre" (recorrente=true, recorrenciaOrigemId=null) é uma
  // atividade normal (com sua própria data/responsável/status) que também
  // serve de modelo: o sistema gera automaticamente as próximas ocorrências
  // como novas Tarefas (recorrenciaOrigemId apontando pra ela), sempre
  // mantendo algumas ocorrências futuras já criadas — sem precisar recriar
  // manualmente toda semana/mês. Pro tipo SEMANAL, o(s) dia(s) da semana é
  // escolhido explicitamente na criação (pode ser mais de um, ex: Seg/Qua/Sex);
  // pro tipo MENSAL, o dia do mês é herdado do prazo da mestre. Cada ocorrência
  // gerada é uma tarefa independente (pode ter responsável/status próprios),
  // preservando o histórico de cada execução para a análise de performance.
  recorrente            Boolean  @default(false)
  recorrenciaTipo       String?  // SEMANAL | MENSAL
  recorrenciaDiasSemana Int[]    @default([]) // 0=Segunda..6=Domingo — um ou mais dias, usado quando SEMANAL
  recorrenciaDiaMes     Int?     // 1..31 — usado quando MENSAL (mês sem esse dia usa o último dia do mês)
  recorrenciaAtiva      Boolean  @default(true) // false = para de gerar novas ocorrências (histórico é preservado)
  recorrenciaOrigemId   String?

  projeto     Projeto   @relation(fields: [projetoId], references: [id])
  responsavel Usuario?  @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
  documentos  Documento[]
  planejamentosSemana TarefaSemana[]
  origemRecorrencia     Tarefa?  @relation("RecorrenciaInstancias", fields: [recorrenciaOrigemId], references: [id])
  instanciasRecorrencia Tarefa[] @relation("RecorrenciaInstancias")

  // Evita gerar duas ocorrências da mesma recorrência na mesma data (NULLs
  // não conflitam entre si no Postgres, então tarefas não-recorrentes — a
  // grande maioria — não são afetadas por essa restrição).
  @@unique([recorrenciaOrigemId, prazo])
  @@map("tarefas")
}

// ============================================================
// DOCUMENTOS
// ============================================================

model Documento {
  id           String   @id @default(cuid())
  nome         String
  tipo         String?
  categoria    String?
  url          String
  driveFileId  String?
  tamanho      Int?
  projetoId    String?
  tarefaId     String?
  uploadadoPor String?
  criadoEm    DateTime @default(now())

  projeto  Projeto?  @relation(fields: [projetoId],    references: [id])
  tarefa   Tarefa?   @relation(fields: [tarefaId],     references: [id])
  usuario  Usuario?  @relation(fields: [uploadadoPor], references: [id])

  @@map("documentos")
}

// ============================================================
// COMUNICAÇÃO E LOGS
// ============================================================

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  titulo    String
  mensagem  String
  tipo      String   @default("info")
  lida      Boolean  @default(false)
  link      String?
  criadoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("notificacoes")
}

model Comentario {
  id        String   @id @default(cuid())
  projetoId String
  autorId   String
  texto     String
  criadoEm DateTime @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id])
  autor   Usuario @relation(fields: [autorId],   references: [id])

  @@map("comentarios")
}

model Log {
  id         String   @id @default(cuid())
  usuarioId  String?
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?
  ip         String?
  criadoEm  DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("logs")
}

model HistoricoStatus {
  id             String   @id @default(cuid())
  projetoId      String
  statusAnterior String?
  statusNovo     String
  campo          String   @default("statusOperacional")
  observacao     String?
  usuarioId      String?
  criadoEm      DateTime @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id])

  @@map("historico_status")
}

// ============================================================
// PLANEJAMENTO SEMANAL DE TAREFAS
// Seleção leve: qual tarefa o usuário escolheu fazer em qual semana.
// NÃO duplica dados da tarefa — a conclusão é lida direto da Tarefa
// (status/dataConclusao) já existente. Serve só para: (1) organizar a
// rotina do usuário e (2) gerar o KPI de cumprimento semanal por usuário.
// ============================================================

model TarefaSemana {
  id           String   @id @default(cuid())
  tarefaId     String
  usuarioId    String
  semanaInicio DateTime // segunda-feira (00:00) da semana em que foi planejada
  diaSemana    Int?     // 0=Segunda .. 6=Domingo — null = "qualquer dia da semana"
  // "Missão do dia" — item em destaque no dia, definido pelo gestor ou pelo
  // próprio analista. Só um por usuário/dia (reforçado na rota da API).
  // Alimenta o painel de eficiência (indicada x executada) em Gestão de Pessoas.
  missaoDia    Boolean  @default(false)
  // Justificativa obrigatória quando o analista marca a tarefa como executada
  // ou não-executada NO DIA em que ela é a missão do dia — dá contexto do porquê.
  justificativa String?
  criadoEm     DateTime @default(now())

  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([tarefaId, usuarioId, semanaInicio])
  @@map("tarefas_semana")
}

// ============================================================
// CATÁLOGO DE SERVIÇOS
// Alimenta a geração automática de tarefas quando um projeto é criado
// (campo tarefasPadrao: JSON com a lista de tarefas padrão do serviço).
// ============================================================

model TipoServico {
  id                   String   @id @default(cuid())
  nome                 String   @unique
  categoria            String
  descricao            String?
  documentosRequeridos String?
  tarefasPadrao        String?
  ativo                Boolean  @default(true)
  ordem                Int      @default(0)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  @@map("tipos_servico")
}
