# URL base do sistema Ecdise (sem barra no final)
ECDISE_API_URL=https://ecdise.vercel.app

# Token secreto — deve ser IGUAL ao SIGLA_BOT_TOKEN configurado no Vercel
# Gere um token aleatório: python -c "import secrets; print(secrets.token_hex(32))"
SIGLA_BOT_TOKEN=cole_aqui_o_token_gerado

# true = executa sem abrir janela de browser; false = abre janela (útil para depurar)
HEADLESS=true

# Caminho do arquivo de log
LOG_FILE=sigla_checker.log
