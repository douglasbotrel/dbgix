# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ecdise?schema=public"

# Para desenvolvimento com SQLite (mais fácil para começar)
# DATABASE_URL="file:./dev.db"

# JWT Secret — OBRIGATÓRIO. Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA use o valor padrão em produção. O servidor não inicia sem essa variável.
JWT_SECRET="GERE-UMA-STRING-ALEATORIA-FORTE-COM-64-CHARS-HEX"
JWT_EXPIRES_IN="7d"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="outro-secret-para-nextauth"

# Upload de arquivos
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760

# App
APP_NAME="Ecdise"
APP_URL="http://localhost:3000"
