+// ============================================================
+// ACOMPANHAMENTO DE PROCESSOS (pós-protocolo, até a licença)
+// Pendencia.status: ABERTA | CONCLUIDA
+// ============================================================
+
+model Pendencia {
+  id            String    @id @default(cuid())
+  projetoId     String
+  numeroPedido  String
+  data          DateTime
+  prazoResposta DateTime
+  status        String    @default("ABERTA")
+  dataEntrega   DateTime?
+  criadoEm      DateTime  @default(now())
+  atualizadoEm  DateTime  @updatedAt
+
+  projeto Projeto         @relation(fields: [projetoId], references: [id])
+  acoes   AcaoPendencia[]
+
+  @@map("pendencias")
+}
+
+model AcaoPendencia {
+  id            String    @id @default(cuid())
+  pendenciaId   String
+  descricao     String
+  responsavelId String?
+  concluida     Boolean   @default(false)
+  dataConclusao DateTime?
+  criadoEm      DateTime  @default(now())
+  atualizadoEm  DateTime  @updatedAt
+
+  pendencia   Pendencia @relation(fields: [pendenciaId], references: [id])
+  responsavel Usuario?  @relation("AcaoPendenciaResponsavel", fields: [responsavelId], references: [id])
+
+  @@map("acoes_pendencia")
+}
+
+model Licenca {
+  id             String    @id @default(cuid())
+  projetoId      String    @unique
+  numero         String
+  dataEmissao    DateTime
+  dataValidade   DateTime?
+  condicionantes String?
+  documentoUrl   String?
+  criadoEm       DateTime  @default(now())
+  atualizadoEm   DateTime  @updatedAt
+
+  projeto Projeto @relation(fields: [projetoId], references: [id])
+
+  @@map("licencas")
+}
+
